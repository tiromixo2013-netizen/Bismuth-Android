#version 310 es
precision highp int;
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer Flags { uint flags[]; };
layout(std430, binding = 1) readonly buffer LocalOffsets { uint localOffsets[]; };
layout(std430, binding = 2) readonly buffer GroupOffsets { uint groupOffsets[]; };
layout(std430, binding = 3) writeonly buffer VisibleIndices { uint visibleIndices[]; };
struct Candidate { vec4 bounds; uint payload; uint pad0; uint pad1; uint pad2; };
layout(std430, binding = 4) readonly buffer Candidates { Candidate items[]; };
layout(std430, binding = 5) writeonly buffer PackedElementIndices { uint packedIndices[]; };
uniform uint uCount;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uCount || flags[i] == 0u) return;
    uint destination = groupOffsets[gl_WorkGroupID.x] + localOffsets[i];
    uint slot = items[i].payload;
    visibleIndices[destination] = slot;

    // Emit the six 16-bit atlas indices in three packed uint words in the
    // same stable scatter pass; this removes a separate compute dispatch.
    uint base = slot * 4u;
    uint outputBase = destination * 3u;
    uint i0 = base;
    uint i1 = base + 1u;
    uint i2 = base + 2u;
    uint i3 = base + 3u;
    packedIndices[outputBase + 0u] = i0 | (i1 << 16u);
    packedIndices[outputBase + 1u] = i2 | (i3 << 16u);
    packedIndices[outputBase + 2u] = i2 | (i1 << 16u);
}
