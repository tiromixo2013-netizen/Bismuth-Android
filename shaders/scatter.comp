#version 310 es
precision highp int;
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer Flags { uint flags[]; };
layout(std430, binding = 1) readonly buffer LocalOffsets { uint localOffsets[]; };
layout(std430, binding = 2) readonly buffer GroupOffsets { uint groupOffsets[]; };
layout(std430, binding = 3) writeonly buffer VisibleIndices { uint visibleIndices[]; };
uniform uint uCount;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uCount || flags[i] == 0u) return;
    uint destination = groupOffsets[gl_WorkGroupID.x] + localOffsets[i];
    visibleIndices[destination] = i;
}
