#version 310 es
precision highp float;
precision highp int;
layout(local_size_x = 128) in;
struct Candidate { vec4 bounds; uint payload; uint pad0; uint pad1; uint pad2; };
layout(std430, binding = 0) readonly buffer Candidates { Candidate items[]; };
layout(std430, binding = 1) writeonly buffer Flags { uint flags[]; };
layout(std430, binding = 2) writeonly buffer LocalOffsets { uint localOffsets[]; };
layout(std430, binding = 3) writeonly buffer GroupSums { uint groupSums[]; };
uniform vec4 uView;
uniform uint uCount;
shared uint scan[128];
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint lane = gl_LocalInvocationID.x;
    uint group = gl_WorkGroupID.x;
    uint visible = 0u;
    if (i < uCount) {
        vec4 b = items[i].bounds;
        visible = uint(b.z >= uView.x && b.x <= uView.z && b.w >= uView.y && b.y <= uView.w);
        flags[i] = visible;
    }
    scan[lane] = visible;
    barrier();
    for (uint step = 1u; step < 128u; step <<= 1u) {
        uint add = lane >= step ? scan[lane - step] : 0u;
        barrier();
        scan[lane] += add;
        barrier();
    }
    if (i < uCount) localOffsets[i] = scan[lane] - visible;
    if (lane == 127u) groupSums[group] = scan[lane];
}
