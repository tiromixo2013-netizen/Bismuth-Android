#version 310 es
precision highp int;
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer VisibleSlots { uint visibleSlots[]; };
layout(std430, binding = 1) writeonly buffer PackedElementIndices { uint packedIndices[]; };
layout(std430, binding = 2) readonly buffer IndexedCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int baseVertex;
    uint reservedMustBeZero;
};
uniform uint uCandidateCount;
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint visibleQuadCount = indexCount / 6u;
    if (i >= uCandidateCount || i >= visibleQuadCount) return;

    uint base = visibleSlots[i] * 4u;
    uint outputBase = i * 3u;
    uint i0 = base;
    uint i1 = base + 1u;
    uint i2 = base + 2u;
    uint i3 = base + 3u;

    // Pack pairs of 16-bit atlas indices into uint words. This produces the
    // exact six-index, 12-byte-per-quad EBO layout used by GLES_UNSIGNED_SHORT.
    packedIndices[outputBase + 0u] = i0 | (i1 << 16u);
    packedIndices[outputBase + 1u] = i2 | (i3 << 16u);
    packedIndices[outputBase + 2u] = i2 | (i1 << 16u);
}
